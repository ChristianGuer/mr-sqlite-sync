# Copy to .env and fill in your own values. Never commit .env.
# Get an API key from https://marvelrivalsapi.com
MR_API_KEY=your_api_key_here
MR_USERNAME=your_in_game_username
MR_PLAYER_UID=your_numeric_player_uid

# Optional
MR_DB_PATH=./marvelrivals.db
MR_PAGES=3
MR_LIMIT=40
MR_DELAY=300
PORT=3001
